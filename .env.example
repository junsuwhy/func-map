# func-map 站台設定。複製成 .env 後修改（.env 不進版控）。
# 這份範例是 AIATC 後台的設定（網址除外，請填測試站網址）；換到其他 Laravel 站時改成該站的值。

# 要爬的網站（不要填正式站）
FUNC_MAP_BASE_URL=https://beta.example.com

# 登入帳密（也可以放在上一層 docs/.env；沿用 BETA_ACCOUNT / BETA_ACCOUNT_PASSWORD 亦可）
FUNC_MAP_ACCOUNT=
FUNC_MAP_PASSWORD=

# 登入頁與表單選擇器（預設 /login、input[name=email]、input[name=password]、button[type=submit]）
FUNC_MAP_LOGIN_PATH=/user/login?next=/admin
FUNC_MAP_LOGIN_SUBMIT_SELECTOR=form.login-form button.btn--primary

# 從哪一頁開始爬；只爬這個前綴底下的網址（預設等於起始頁）
FUNC_MAP_START_PATH=/admin
# FUNC_MAP_SCOPE_PREFIX=/admin

# Laravel 路由檔，相對於 func-map 資料夾，多個用逗號分隔
FUNC_MAP_ROUTES_FILES=../../routes/web.php

# 版面選擇器：側邊選單、麵包屑、其他不算「頁面內容」的區塊（頁首頁尾等）
FUNC_MAP_NAV_SELECTOR=.sidebar
FUNC_MAP_BREADCRUMB_SELECTOR=.breadcrumb
FUNC_MAP_CHROME_SELECTOR=.admin-header, .site-header, footer

# 沒有連結點得到、要額外補爬的網址（逗號分隔）
FUNC_MAP_SEEDS=/admin/organizations/verify/1,/admin/organizations/verify/2,/admin/organizations/verify/3,/admin/organizations/verify/4,/admin/organizations/verify/5,/admin/organizations/verify/6

# 共用同一路由、但畫面性質不同的網址結尾（例如 /edit/_new 是「新增」）
FUNC_MAP_LITERAL_SEGMENTS=_new

# 有副作用或會下載檔案、不要點的網址（regex，逗號分隔；logout、delete、destroy、xlsx/csv/export/download 已內建）
FUNC_MAP_SKIP=reloadi18n,downloadi18n,/invoice,/refund,/user/auth/,unlinkgoogle,/i18n/,/i18nenable/

# 截圖視窗大小與語系
FUNC_MAP_VIEWPORT=1440x900
FUNC_MAP_LOCALE=zh-TW
